# Local observing inputs and generated science products (all descendants).
# Keep bundled reference calibrations under trunk/src/ntt tracked.
/data/
/runs/
# Retired root output paths stay ignored to catch accidental legacy writes safely.
/outputs/
/wiserep_tns_upload/

# Python builds, virtual environments and caches.
/build/
/dist/
trunk/build/
trunk/dist/
*.egg-info/
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.coverage*
htmlcov/
# PyRAF creates this local command cache when legacy tools start.
/pyraf/clcache.sqlite3*

# Local CI artifacts; CI recreates these when required.
/badge-data/
/test-results/

# Local credentials and workstation metadata.
.env
.env.*
!.env.example
.DS_Store
.idea/
*.iml
*~
pessto-pipeline.sublime-project
pessto-pipeline.sublime-workspace

# Retained upstream exclusions for legacy downloads and test datasets.
*.gz
*.xml
test
Test_data_GR18
Test_data_GR18_new
Test_data_GR20

# Private local guidance, source manuals and superseded planning.
/AGENTS.md
/docs/DEVELOPMENT_LOG.md
